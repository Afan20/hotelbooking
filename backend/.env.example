DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
JWT_SECRET="replace-with-a-strong-random-secret"
PORT=8080

# Frontend origin allowed for staff app.
CORS_ORIGIN="http://localhost:5173"

# Shared key for /api/agent endpoints.
AGENT_API_KEY="replace-with-long-random-token"

# Used when a phone number arrives without country code.
DEFAULT_COUNTRY_CODE="+92"
